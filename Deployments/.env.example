
# Base de datos
POSTGRES_DB=tcgcommunity
POSTGRES_USER=tcg
POSTGRES_PASSWORD=tcg

# Puertos publicados en el host
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Spring Boot: elegir explícitamente el perfil
SPRING_PROFILES_ACTIVE=dev

# Generar un secreto con:
# openssl rand -base64 48
JWT_SECRET=

# Imágenes Docker
BACKEND_IMAGE=tcgcommunity-backend-app:0.0.1
FRONTEND_IMAGE=tcgcommunity-front-app:0.0.1

# Comunicación Next.js -> backend
API_BASE_URL=http://backend:8080

# Opcional: configuración de trazas propia de la aplicación
API_DEV=
