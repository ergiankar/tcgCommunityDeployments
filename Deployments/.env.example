# ==========================================
# BASE DE DATOS
# ==========================================
POSTGRES_DB=tcgcommunity
POSTGRES_USER=tcg
POSTGRES_PASSWORD=CAMBIAR_PASSWORD

POSTGRES_PORT=5432

# ==========================================
# OPENBAO
# ==========================================
# Token de alcance limitado para el backend. Se crea durante la inicialización
# indicada en README; no usar aquí el token raíz de OpenBao.
OPENBAO_BACKEND_TOKEN=

# ==========================================
# VERIFICACIÓN DE FOTOS
# ==========================================
# Obligatoria y LA MISMA para el backend y el frontend: el frontend firma las fotos que ha comprobado y el backend
# comprueba la firma. Generar con: openssl rand -hex 32
# El backend la lee de OpenBao (app.photo-verification.secret). El frontend la
# necesita al arrancar para firmar las fotos, así que por ahora también se define
# aquí; debe tener exactamente el mismo valor que el guardado en OpenBao.
PHOTO_VERIFICATION_SECRET=

# ==========================================
# PUERTOS
# ==========================================
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ==========================================
# SPRING BOOT
# ==========================================
SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:postgresql://postgres:5432/tcgcommunity
DB_USER=tcg
# El backend obtiene spring.datasource.password de OpenBao. PostgreSQL conserva
# POSTGRES_PASSWORD para su propia inicialización.

# Generar con: openssl rand -base64 48
# Se guarda en OpenBao (clave app.security.jwt.secret), no en este archivo.

FRONTEND_URL=http://localhost:3000
REQUIRE_VERIFIED_EMAIL=true

# ==========================================
# GOOGLE
# ==========================================
GOOGLE_CLIENT_ID=

# ==========================================
# EMAIL
# ==========================================
MAIL_PROVIDER=smtp
MAIL_FROM=ageek@dominio.com

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=tu_correo@gmail.com
# Se guarda en OpenBao (clave spring.mail.password), no en este archivo.

SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# ==========================================
# LOGGING
# ==========================================
LOG_FILE=logs/backend.log

# ==========================================
# DOCKER IMAGES
# ==========================================
BACKEND_IMAGE=ghcr.io/alemsevilla/tcgcommunity-backend-app:0.0.5
FRONTEND_IMAGE=ghcr.io/alemsevilla/tcgcommunity-front-app:0.0.5

# ==========================================
# NEXT.JS
# ==========================================
API_BASE_URL=http://backend:8080
API_DEV=
